# Copy this file to .env.local and fill in the values.
# Values: Supabase -> Project Settings -> API Keys (ask Bryan if you don't have access).
# .env.local is ignored by git. Never commit real keys.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy "anon public" key.
# Do NOT use the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
